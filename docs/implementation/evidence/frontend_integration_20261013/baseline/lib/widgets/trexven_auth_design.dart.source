import 'dart:ui' as ui;

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:trexven_design_system/trexven_design_system.dart';

/// Authentication-only visual language. Does not modify the app-wide theme.
class TrexvenAuthColors {
  const TrexvenAuthColors._();
  static const navy = Color(0xFF14213D);
  static const blue = Color(0xFF2864F0);
  static const muted = Color(0xFF71809A);
  static const border = Color(0xFFDDE7F6);
  static const pale = Color(0xFFF0F5FF);
}

/// Large, pale glass T drawn behind the functional UI.
/// This is decoration only; all text and buttons are live Flutter widgets.
class TrexvenAuthShell extends StatelessWidget {
  final Widget child;
  const TrexvenAuthShell({super.key, required this.child});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF6F8FE),
      body: Stack(
        children: [
          const Positioned.fill(
            child: DecoratedBox(
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                  colors: [
                    Color(0xFFDFEDFF),
                    Color(0xFFF9FBFF),
                    Colors.white,
                    Color(0xFFE9F1FF),
                  ],
                  stops: [0, .36, .66, 1],
                ),
              ),
            ),
          ),
          const Positioned.fill(
            child: IgnorePointer(
              child: CustomPaint(painter: _FrostedTPainter()),
            ),
          ),
          SafeArea(child: child),
        ],
      ),
    );
  }
}

class _FrostedTPainter extends CustomPainter {
  const _FrostedTPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    // Wide upper stroke of a giant, lightly angled geometric T.
    final top = Path()
      ..moveTo(-.28 * w, -.03 * h)
      ..lineTo(1.04 * w, .16 * h)
      ..quadraticBezierTo(1.10 * w, .18 * h, 1.02 * w, .26 * h)
      ..lineTo(.81 * w, .46 * h)
      ..lineTo(.08 * w, .28 * h)
      ..quadraticBezierTo(.03 * w, .27 * h, -.01 * w, .22 * h)
      ..close();

    final middle = Path()
      ..moveTo(.18 * w, .27 * h)
      ..lineTo(.52 * w, .35 * h)
      ..lineTo(.52 * w, .82 * h)
      ..quadraticBezierTo(.52 * w, .85 * h, .49 * w, .84 * h)
      ..lineTo(.18 * w, .72 * h)
      ..close();

    final right = Path()
      ..moveTo(.52 * w, .35 * h)
      ..lineTo(.82 * w, .45 * h)
      ..lineTo(.52 * w, .79 * h)
      ..close();

    void drawGlass(Path path, List<Color> colors) {
      final bounds = path.getBounds();
      final fill = Paint()
        ..shader = ui.Gradient.linear(
          bounds.topLeft,
          bounds.bottomRight,
          colors,
        );
      canvas.drawPath(path, fill);
      final edgeGlow = Paint()
        ..color = Colors.white.withValues(alpha: .58)
        ..strokeWidth = 3.5
        ..style = PaintingStyle.stroke
        ..maskFilter = const ui.MaskFilter.blur(ui.BlurStyle.normal, 5);
      canvas.drawPath(path, edgeGlow);
      final edge = Paint()
        ..color = Colors.white.withValues(alpha: .65)
        ..strokeWidth = 1.3
        ..style = PaintingStyle.stroke;
      canvas.drawPath(path, edge);
    }

    drawGlass(top, [
      const Color(0xFFB5DCFF).withValues(alpha: .53),
      const Color(0xFFC1D9FF).withValues(alpha: .35),
      const Color(0xFF8CBAFF).withValues(alpha: .27),
    ]);
    drawGlass(middle, [
      const Color(0xFFB4D8FF).withValues(alpha: .32),
      const Color(0xFF8EBBFF).withValues(alpha: .19),
    ]);
    drawGlass(right, [
      const Color(0xFFB5E4FF).withValues(alpha: .42),
      const Color(0xFFB5D1FF).withValues(alpha: .17),
    ]);
  }

  @override
  bool shouldRepaint(covariant _FrostedTPainter oldDelegate) => false;
}

/// Uses a separate, transparent image so the black square cannot reappear.
class TrexvenAuthBrand extends StatelessWidget {
  final double size;
  const TrexvenAuthBrand({super.key, this.size = 82});

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        Image.asset(
          'assets/images/trexven_t_transparent.png',
          width: size,
          height: size,
          fit: BoxFit.contain,
          filterQuality: FilterQuality.high,
          errorBuilder: (_, __, ___) => Icon(
            Icons.storefront_rounded,
            size: size * .7,
            color: TrexvenAuthColors.blue,
          ),
        ),
        const SizedBox(height: 11),
        const Text(
          'TREXVEN',
          textAlign: TextAlign.center,
          style: TextStyle(
            color: TrexvenAuthColors.navy,
            fontSize: 22,
            fontWeight: FontWeight.w900,
            letterSpacing: 3,
          ),
        ),
      ],
    );
  }
}

class TrexvenAuthCard extends StatelessWidget {
  final Widget child;
  const TrexvenAuthCard({super.key, required this.child});

  @override
  Widget build(BuildContext context) {
    return ClipRRect(
      borderRadius: BorderRadius.circular(28),
      child: BackdropFilter(
        filter: ui.ImageFilter.blur(sigmaX: 10, sigmaY: 10),
        child: Container(
          width: double.infinity,
          padding: const EdgeInsets.fromLTRB(20, 22, 20, 22),
          decoration: BoxDecoration(
            color: Colors.white.withValues(alpha: .82),
            borderRadius: BorderRadius.circular(28),
            border: Border.all(
              color: Colors.white.withValues(alpha: .88),
              width: 1.2,
            ),
          ),
          child: child,
        ),
      ),
    );
  }
}

/// Reuses the user's existing TrexvenTextFormField, with local visual styling.
/// The shared input theme and component are not changed globally.
class TrexvenAuthField extends StatelessWidget {
  final String label;
  final String hint;
  final TextEditingController controller;
  final Widget prefixIcon;
  final Widget? suffixIcon;
  final BoxConstraints? prefixIconConstraints;
  final TextInputType? keyboardType;
  final TextInputAction? textInputAction;
  final Iterable<String>? autofillHints;
  final List<TextInputFormatter>? inputFormatters;
  final bool obscureText;
  final bool enabled;
  final ValueChanged<String>? onChanged;
  final FormFieldValidator<String>? validator;

  const TrexvenAuthField({
    super.key,
    required this.label,
    required this.hint,
    required this.controller,
    required this.prefixIcon,
    this.suffixIcon,
    this.prefixIconConstraints,
    this.keyboardType,
    this.textInputAction,
    this.autofillHints,
    this.inputFormatters,
    this.obscureText = false,
    this.enabled = true,
    this.onChanged,
    this.validator,
  });

  @override
  Widget build(BuildContext context) {
    OutlineInputBorder fieldBorder(Color color, double width) {
      return OutlineInputBorder(
        borderRadius: BorderRadius.circular(17),
        borderSide: BorderSide(color: color, width: width),
      );
    }

    return TrexvenTextFormField(
      controller: controller,
      label: label,
      showLabel: true,
      gap: 0,
      enabled: enabled,
      keyboardType: keyboardType,
      textInputAction: textInputAction,
      autofillHints: autofillHints,
      inputFormatters: inputFormatters,
      obscureText: obscureText,
      autocorrect: !obscureText,
      enableSuggestions: !obscureText,
      onChanged: onChanged,
      validator: validator,
      decoration: InputDecoration(
        hintText: hint,
        hintStyle: const TextStyle(
          color: Color(0xFF91A0B8),
          fontSize: 13,
        ),
        prefixIcon: prefixIcon,
        prefixIconConstraints: prefixIconConstraints,
        suffixIcon: suffixIcon,
        filled: true,
        fillColor: const Color(0xFFEFF4FD).withValues(alpha: .94),
        isDense: true,
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 14,
          vertical: 17,
        ),
        border: fieldBorder(TrexvenAuthColors.border, 1),
        enabledBorder: fieldBorder(TrexvenAuthColors.border, 1),
        focusedBorder: fieldBorder(TrexvenAuthColors.blue, 1.6),
        errorBorder: fieldBorder(const Color(0xFFD64545), 1),
        focusedErrorBorder: fieldBorder(const Color(0xFFD64545), 1.6),
      ),
    );
  }
}

class TrexvenAuthPrimaryButton extends StatelessWidget {
  final String label;
  final VoidCallback? onPressed;
  final bool loading;
  final bool showArrow;

  const TrexvenAuthPrimaryButton({
    super.key,
    required this.label,
    required this.onPressed,
    this.loading = false,
    this.showArrow = true,
  });

  @override
  Widget build(BuildContext context) {
    final enabled = onPressed != null && !loading;
    return Opacity(
      opacity: enabled || loading ? 1 : .55,
      child: Material(
        color: Colors.transparent,
        child: Ink(
          height: 56,
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              begin: Alignment.centerLeft,
              end: Alignment.centerRight,
              colors: [Color(0xFF2168F4), Color(0xFF257FFF)],
            ),
            borderRadius: BorderRadius.circular(23),
            boxShadow: [
              BoxShadow(
                color: TrexvenAuthColors.blue.withValues(alpha: .17),
                blurRadius: 16,
                offset: const Offset(0, 7),
              ),
            ],
          ),
          child: InkWell(
            borderRadius: BorderRadius.circular(23),
            onTap: enabled ? onPressed : null,
            child: Center(
              child: loading
                  ? const SizedBox(
                      width: 22,
                      height: 22,
                      child: CircularProgressIndicator(
                        color: Colors.white,
                        strokeWidth: 2.4,
                      ),
                    )
                  : Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          label,
                          style: const TextStyle(
                            color: Colors.white,
                            fontSize: 16,
                            fontWeight: FontWeight.w700,
                          ),
                        ),
                        if (showArrow) ...[
                          const SizedBox(width: 13),
                          const Icon(
                            Icons.arrow_forward_rounded,
                            size: 21,
                            color: Colors.white,
                          ),
                        ],
                      ],
                    ),
            ),
          ),
        ),
      ),
    );
  }
}

class TrexvenAuthSecondaryButton extends StatelessWidget {
  final String label;
  final VoidCallback? onPressed;
  const TrexvenAuthSecondaryButton({
    super.key,
    required this.label,
    required this.onPressed,
  });

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: double.infinity,
      height: 56,
      child: TextButton(
        onPressed: onPressed,
        style: TextButton.styleFrom(
          backgroundColor: const Color(0xFFE4ECFC).withValues(alpha: .9),
          foregroundColor: TrexvenAuthColors.navy,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(23),
          ),
        ),
        child: Text(
          label,
          style: const TextStyle(
            color: TrexvenAuthColors.navy,
            fontSize: 16,
            fontWeight: FontWeight.w700,
          ),
        ),
      ),
    );
  }
}

class TrexvenAuthBackButton extends StatelessWidget {
  final VoidCallback? onPressed;
  const TrexvenAuthBackButton({super.key, this.onPressed});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(17, 5, 0, 0),
      child: Align(
        alignment: Alignment.centerLeft,
        child: Material(
          color: Colors.white.withValues(alpha: .45),
          shape: CircleBorder(
            side: BorderSide(
              color: Colors.white.withValues(alpha: .85),
            ),
          ),
          child: IconButton(
            icon: const Icon(
              Icons.arrow_back_ios_new_rounded,
              color: TrexvenAuthColors.navy,
              size: 19,
            ),
            onPressed: onPressed,
          ),
        ),
      ),
    );
  }
}

class TrexvenAuthOrDivider extends StatelessWidget {
  const TrexvenAuthOrDivider({super.key});

  @override
  Widget build(BuildContext context) {
    return const Row(
      children: [
        Expanded(child: Divider(color: Color(0xFFD9E2F0))),
        Padding(
          padding: EdgeInsets.symmetric(horizontal: 16),
          child: Text(
            'OR',
            style: TextStyle(
              color: TrexvenAuthColors.muted,
              fontSize: 12,
              fontWeight: FontWeight.w600,
            ),
          ),
        ),
        Expanded(child: Divider(color: Color(0xFFD9E2F0))),
      ],
    );
  }
}
