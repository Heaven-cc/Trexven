# -------------------------------------------------------
# ODT / Trexven — Vision Server Environment
# Copy this file to .env and fill in your values.
# -------------------------------------------------------

# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://ufehcfrlygqvminfjumf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Vision API Security ─────────────────────────────────
# Pick any strong secret.  Flutter will use this key.
VISION_API_KEY=change-me-to-a-strong-secret

# ── AI Model ────────────────────────────────────────────
MODEL_PATH=yolo11n.pt
CONFIDENCE_THRESHOLD=0.50

# ── Server binding ──────────────────────────────────────
# For local testing: 0.0.0.0 lets your phone reach it over WiFi.
# For cloud:        0.0.0.0 behind your reverse proxy (nginx/caddy).
HOST=0.0.0.0
PORT=8000

# ── Recording ───────────────────────────────────────────
# How long each video segment is (seconds). Default: 300 (5 min)
# SEGMENT_SECONDS=300

# ── Event Tuning ────────────────────────────────────────
# EVENT_COOLDOWN_SECONDS=5.0
# ZONE_EVENT_COOLDOWN_SECONDS=8.0
# LOITERING_SECONDS=30.0
# CROWD_THRESHOLD=5
# FRAME_INTERVAL_SECONDS=0.10
# RECONNECT_DELAY_SECONDS=3.0
# POLL_INTERVAL_SECONDS=2.0

# ── JPEG quality for /frame endpoint (1-100) ─────────────
# JPEG_QUALITY=82
